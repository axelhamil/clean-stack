{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts src/migrate.ts --outdir dist --target bun --minify",
    "migrate": "bun src/migrate.ts",
    "db:seed": "bun scripts/seed-dev-user.ts",
    "check:fanout": "bun scripts/check-fanout-preferences.ts",
    "check:digest": "bun scripts/check-digest-window.ts",
    "check:api-token-visibility": "bun scripts/check-api-token-visibility.ts",
    "check:wipe-rollback": "bun scripts/check-wipe-rollback.ts",
    "check:marksent": "bun scripts/check-marksent.ts",
    "check:enqueue": "bun scripts/check-enqueue.ts",
    "check:sweep-lock": "bun scripts/check-sweep-lock.ts",
    "check:uow-rollback": "bun scripts/check-uow-rollback.ts",
    "check:auth-transaction": "bun scripts/check-auth-transaction.ts",
    "check:scim-seats": "bun scripts/check-scim-seats.ts",
    "check:scim-connection": "bun scripts/check-scim-connection.ts",
    "check:totp-enrolment": "bun scripts/check-totp-enrolment.ts",
    "check:outbox-lease": "bun scripts/check-outbox-lease.ts",
    "check:email-lease": "bun scripts/check-email-lease.ts",
    "check:webhook-lease": "bun scripts/check-webhook-lease.ts",
    "check:admin-staff": "bun scripts/check-admin-staff.ts",
    "start": "bun dist/migrate.js && bun dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "bun test --isolate --parallel --pass-with-no-tests",
    "test:watch": "bun test --isolate --watch --pass-with-no-tests",
    "test:coverage": "bun test --isolate --parallel --coverage --pass-with-no-tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@better-auth/passkey": "1.7.14",
    "@better-auth/scim": "1.7.14",
    "@better-auth/sso": "1.7.14",
    "@better-auth/stripe": "1.7.14",
    "@better-auth/utils": "0.5.1",
    "@hono/zod-validator": "^0.9.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@packages/access-control": "workspace:*",
    "@packages/cookie-consent": "workspace:*",
    "@packages/ddd-kit": "workspace:*",
    "@packages/drizzle": "workspace:*",
    "@packages/emails": "workspace:*",
    "@packages/events": "workspace:*",
    "@packages/i18n": "workspace:*",
    "@packages/policies": "workspace:*",
    "@packages/sentry-scrub": "workspace:*",
    "@sentry/bun": "^11.9.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-auth": "1.7.14",
    "disposable-email-domains": "^1.0.62",
    "hono": "^4.13.14",
    "hono-pino": "^0.10.3",
    "inwire": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rate-limiter-flexible": "^11.2.3",
    "resend": "^6.35.0",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.14",
    "@packages/test": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
