                };
            };
            outputFormat: "json";
            status: import("hono/utils/http-status").ContentfulStatusCode;
            input: {
                json: {
                    types?: ("privacy" | "terms")[] | undefined;
                };
            };
        };
    };
} & {
    "/": {
