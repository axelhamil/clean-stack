VITE_API_URL=http://localhost:3000

# The only external target sign-in may send a browser back to, the back office host. Empty = none.
VITE_ADMIN_URL=http://localhost:5174

# Sentry (Phase 0.4) — error tracking. Empty DSN = NoOp, Sentry SDK tree-shaken out at build.
# EU residency: use *.eu.sentry.io DSN.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
# Injected at CI build for release tracking + source maps upload.
VITE_GIT_SHA=

# Stripe — publishable key for Stripe.js / Elements
VITE_STRIPE_PUBLISHABLE_KEY=
