{
  "name": "@packages/drizzle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./sweep-count": "./src/sweep-count.ts",
    "./sweep-purge": "./src/sweep-purge.ts",
    "./sweep-span": "./src/sweep-span.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "echo 'no seeds yet'",
    "format": "biome format . --write",
    "lint": "biome lint .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@packages/ddd-kit": "workspace:*",
    "@packages/events": "workspace:*",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@packages/test": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
