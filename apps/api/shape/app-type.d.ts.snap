                    targetId?: string | undefined;
                    actionPrefix?: string | undefined;
                    occurredFrom?: string | undefined;
                    occurredTo?: string | undefined;
                    limit?: unknown;
                    cursor?: string | undefined;
                };
            };
        };
    };
} & {
