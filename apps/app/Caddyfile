{
    auto_https off
    admin off
    persist_config off
    servers {
        trusted_proxies static private_ranges
    }
}

import /etc/caddy/static-site.caddy

# CSP reports post to {VITE_API_URL}/csp-report — VITE_API_URL is already required at build and exposed
# at runtime by Railway, so no extra var. It must be the API's public HTTPS URL in prod (browser-evaluated).
:{$PORT:80} {
    import spa_site
    import security_headers

    header {
        Content-Security-Policy "default-src 'self'; script-src 'nonce-{http.request.uuid}' 'strict-dynamic' https: 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri {$VITE_API_URL:http://localhost:3000}/csp-report; report-to csp-endpoint"
        Reporting-Endpoints `csp-endpoint="{$VITE_API_URL:http://localhost:3000}/csp-report"`
    }
}
