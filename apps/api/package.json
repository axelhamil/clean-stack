{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts src/migrate.ts --outdir dist --target bun --minify",
    "migrate": "bun src/migrate.ts",
    "db:seed": "bun scripts/seed-dev-user.ts",
    "check:fanout": "bun scripts/check-fanout-preferences.ts",
    "check:wipe-rollback": "bun scripts/check-wipe-rollback.ts",
    "check:marksent": "bun scripts/check-marksent.ts",
    "check:enqueue": "bun scripts/check-enqueue.ts",
    "check:sweep-lock": "bun scripts/check-sweep-lock.ts",
    "start": "bun dist/migrate.js && bun dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:watch": "bun test --watch --pass-with-no-tests",
    "test:coverage": "bun test --coverage --pass-with-no-tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@better-auth/passkey": "1.6.30",
    "@better-auth/scim": "1.6.30",
    "@better-auth/sso": "1.6.30",
    "@better-auth/stripe": "1.6.30",
    "@better-auth/utils": "^0.4.2",
    "@hono/zod-validator": "^0.9.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@packages/access-control": "workspace:*",
    "@packages/cookie-consent": "workspace:*",
    "@packages/ddd-kit": "workspace:*",
    "@packages/drizzle": "workspace:*",
    "@packages/emails": "workspace:*",
    "@packages/events": "workspace:*",
    "@packages/i18n": "workspace:*",
    "@packages/policies": "workspace:*",
    "@sentry/bun": "^10.71.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-auth": "1.6.30",
    "disposable-email-domains": "^1.0.62",
    "hono": "^4.13.5",
    "hono-pino": "^0.10.3",
    "inwire": "^3.1.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "rate-limiter-flexible": "^11.2.0",
    "resend": "^6.24.0",
    "stripe": "^22.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@packages/test": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
